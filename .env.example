# Supabase（サーバー側だけで使う。ブラウザには出さない）
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# このアプリの公開URL（ログインリンク・紹介リンクに使う）
APP_URL=https://referral.consilegy.com

# 紹介リンクのCookieを consilegy.com 全体で読めるようにする
REF_COOKIE_DOMAIN=.consilegy.com

# 口座情報・通知キーの暗号化（32バイトをbase64に。例: openssl rand -base64 32）
DATA_ENCRYPTION_KEY=

# メール（Resend）
RESEND_API_KEY=
MAIL_FROM=Consilegy <no-reply@consilegy.com>
ADMIN_NOTIFY_EMAIL=

# Vercel Cron の認証
CRON_SECRET=

# 運営会社（今はconsilegyだけ）
OPERATOR_SLUG=consilegy
